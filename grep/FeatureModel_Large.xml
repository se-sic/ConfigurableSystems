<vm name="gzip">
  <binaryOptions>
    <configurationOption>
      <name>root</name>
      <optional>False</optional>
    </configurationOption>
<!-- Matching Control -->
    <configurationOption>
      <name>ignore_case</name>
      <outputString>-i</outputString>
      <parent>root</parent>
      <optional>True</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>invert_match</name>
      <outputString>-v</outputString>
      <parent>root</parent>
      <optional>True</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>match_kind</name>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>word_regex</name>
      <outputString>-w</outputString>
      <parent>match_kind</parent>
      <excludedOptions>
        <options>line_regex</options>
      </excludedOptions>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>line_regex</name>
      <outputString>-x</outputString>
      <parent>match_kind</parent>
      <excludedOptions>
        <options>word_regex</options>
      </excludedOptions>
      <locations>
      </locations>
    </configurationOption>
<!-- General Output Control -->
    <configurationOption>
      <name>count</name>
      <outputString>-c</outputString>
      <parent>root</parent>
      <optional>True</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>print_file</name>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>files_with_match</name>
      <outputString>-l</outputString>
      <parent>print_file</parent>
      <excludedOptions>
        <options>files_without_match</options>
      </excludedOptions>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>files_without_match</name>
      <outputString>-L</outputString>
      <parent>print_file</parent>
      <excludedOptions>
        <options>files_with_match</options>
      </excludedOptions>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>only_matching</name>
      <outputString>-o</outputString>
      <parent>root</parent>
      <excludedOptions>
        <options>context</options>
        <options>before_context</options>
        <options>after_context</options>
      </excludedOptions>
      <optional>True</optional>
      <locations>
      </locations>
    </configurationOption>
<!-- Output Line Prefix Control -->
    <configurationOption>
      <name>line_number</name>
      <outputString>-n</outputString>
      <parent>root</parent>
      <optional>True</optional>
      <locations>
      </locations>
    </configurationOption>
<!-- Context Line Control -->
    <configurationOption>
      <name>context</name>
      <parent>root</parent>
      <excludedOptions>
        <options>only_matching</options>
        <options>before_context</options>
        <options>after_context</options>
      </excludedOptions>
      <optional>True</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>before_context</name>
      <parent>root</parent>
      <excludedOptions>
        <options>only_matching</options>
        <options>context</options>
      </excludedOptions>
      <optional>True</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>after_context</name>
      <parent>root</parent>
      <excludedOptions>
        <options>only_matching</options>
        <options>context</options>
      </excludedOptions>
      <optional>True</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>context_1</name>
      <outputString>-C1</outputString>
      <parent>context</parent>
      <excludedOptions>
        <options>context_5</options>
        <options>context_10</options>
      </excludedOptions>
    </configurationOption>
    <configurationOption>
      <name>context_5</name>
      <outputString>-C5</outputString>
      <parent>context</parent>
      <excludedOptions>
        <options>context_1</options>
        <options>context_10</options>
      </excludedOptions>
    </configurationOption>
    <configurationOption>
      <name>context_10</name>
      <outputString>-C10</outputString>
      <parent>context</parent>
      <excludedOptions>
        <options>context_1</options>
        <options>context_5</options>
      </excludedOptions>
    </configurationOption>
    <configurationOption>
      <name>before_context_1</name>
      <outputString>-B1</outputString>
      <parent>before_context</parent>
      <excludedOptions>
        <options>before_context_5</options>
        <options>before_context_10</options>
      </excludedOptions>
    </configurationOption>
    <configurationOption>
      <name>before_context_5</name>
      <outputString>-B5</outputString>
      <parent>before_context</parent>
      <excludedOptions>
        <options>before_context_1</options>
        <options>before_context_10</options>
      </excludedOptions>
    </configurationOption>
    <configurationOption>
      <name>before_context_10</name>
      <outputString>-B10</outputString>
      <parent>before_context</parent>
      <excludedOptions>
        <options>before_context_1</options>
        <options>before_context_5</options>
      </excludedOptions>
    </configurationOption>
    <configurationOption>
      <name>after_context_1</name>
      <outputString>-A1</outputString>
      <parent>after_context</parent>
      <excludedOptions>
        <options>after_context_5</options>
        <options>after_context_10</options>
      </excludedOptions>
    </configurationOption>
    <configurationOption>
      <name>after_context_5</name>
      <outputString>-A5</outputString>
      <parent>after_context</parent>
      <excludedOptions>
        <options>after_context_1</options>
        <options>after_context_10</options>
      </excludedOptions>
    </configurationOption>
    <configurationOption>
      <name>after_context_10</name>
      <outputString>-A10</outputString>
      <parent>after_context</parent>
      <excludedOptions>
        <options>after_context_1</options>
        <options>after_context_5</options>
      </excludedOptions>
    </configurationOption>
  </binaryOptions>
  <numericOptions>
  </numericOptions>
  <booleanConstraints />
  <nonBooleanConstraints />
  <mixedConstraints />
</vm>
