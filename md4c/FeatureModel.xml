<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE vm
SYSTEM "vm.dtd">
<vm name="FeatureModel" root="">
  <binaryOptions>
    <configurationOption>
      <name>root</name>
      <optional>False</optional>
    </configurationOption>
<!-- Parser extensions -->
    <configurationOption>
      <name>admonitions</name>
      <outputString>--fadmonitions</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>footnotes</name>
      <outputString>--ffootnotes</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>highlight</name>
      <outputString>--fhighlight</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>insert</name>
      <outputString>--finsert</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>latex_math</name>
      <outputString>--flatex-math</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>spoilers</name>
      <outputString>--fspoilers</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>strikethrough</name>
      <outputString>--fstrikethrough</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>subscripts</name>
      <outputString>--fsubscripts</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>superscripts</name>
      <outputString>--fsuperscripts</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>tables</name>
      <outputString>--ftables</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>tasklists</name>
      <outputString>--ftasklists</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>underline</name>
      <outputString>--funderline</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>wiki_links</name>
      <outputString>--fwiki-links</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
<!-- Autolinks: fpermissive-autolinks == url | www | email -->
    <configurationOption>
      <name>permissive_autolinks</name>
      <outputString>--fpermissive-autolinks</outputString>
      <parent>root</parent>
      <excludedOptions>
        <options>permissive_url_autolinks</options>
        <options>permissive_www_autolinks</options>
        <options>permissive_email_autolinks</options>
      </excludedOptions>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>permissive_url_autolinks</name>
      <outputString>--fpermissive-url-autolinks</outputString>
      <parent>root</parent>
      <excludedOptions>
        <options>permissive_autolinks</options>
      </excludedOptions>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>permissive_www_autolinks</name>
      <outputString>--fpermissive-www-autolinks</outputString>
      <parent>root</parent>
      <excludedOptions>
        <options>permissive_autolinks</options>
      </excludedOptions>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>permissive_email_autolinks</name>
      <outputString>--fpermissive-email-autolinks</outputString>
      <parent>root</parent>
      <excludedOptions>
        <options>permissive_autolinks</options>
      </excludedOptions>
      <optional>True</optional>
    </configurationOption>
<!-- Parser behavior -->
    <configurationOption>
      <name>collapse_whitespace</name>
      <outputString>--fcollapse-whitespace</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>hard_soft_breaks</name>
      <outputString>--fhard-soft-breaks</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>permissive_atx_headers</name>
      <outputString>--fpermissive-atx-headers</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>preserve_blank_lines</name>
      <outputString>--fpreserve-blank-lines</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>no_indented_code</name>
      <outputString>--fno-indented-code</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
<!-- Raw HTML: fno-html == fno-html-blocks + fno-html-spans -->
    <configurationOption>
      <name>no_html</name>
      <outputString>--fno-html</outputString>
      <parent>root</parent>
      <excludedOptions>
        <options>no_html_blocks</options>
        <options>no_html_spans</options>
      </excludedOptions>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>no_html_blocks</name>
      <outputString>--fno-html-blocks</outputString>
      <parent>root</parent>
      <excludedOptions>
        <options>no_html</options>
      </excludedOptions>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>no_html_spans</name>
      <outputString>--fno-html-spans</outputString>
      <parent>root</parent>
      <excludedOptions>
        <options>no_html</options>
      </excludedOptions>
      <optional>True</optional>
    </configurationOption>
<!-- HTML renderer -->
    <configurationOption>
      <name>verbatim_entities</name>
      <outputString>--fverbatim-entities</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>xhtml</name>
      <outputString>-x</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>full_html</name>
      <outputString>-f</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>html_title</name>
      <outputString>--html-title=Document</outputString>
      <parent>root</parent>
      <impliedOptions>
        <options>full_html</options>
      </impliedOptions>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>html_css</name>
      <outputString>--html-css=style.css</outputString>
      <parent>root</parent>
      <impliedOptions>
        <options>full_html</options>
      </impliedOptions>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>stat</name>
      <outputString>-s</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
  </binaryOptions>
  <numericOptions />
  <booleanConstraints />
  <nonBooleanConstraints />
  <mixedConstraints />
</vm>
