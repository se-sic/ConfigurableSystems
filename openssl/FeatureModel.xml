<vm name="gzip">
  <binaryOptions>
    <configurationOption>
      <name>root</name>
      <optional>False</optional>
    </configurationOption>
<!-- Ciphers -->
    <configurationOption>
      <name>cipher</name>
      <parent>root</parent>
      <optional>False</optional>
    </configurationOption>
    <configurationOption>
      <name>AES-128-CBC</name>
      <outputString>-aes-128-cbc</outputString>
      <parent>cipher</parent>
      <excludedOptions>
        <options>AES-128-OFB</options>
        <options>AES-256-CBC</options>
        <options>Blowfish-CBC</options>
      </excludedOptions>
      <optional>False</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>AES-128-OFB</name>
      <outputString>-aes-128-ofb</outputString>
      <parent>cipher</parent>
      <excludedOptions>
        <options>AES-128-CBC</options>
        <options>AES-256-CBC</options>
        <options>Blowfish-CBC</options>
      </excludedOptions>
      <optional>False</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>AES-256-CBC</name>
      <outputString>-aes-256-cbc</outputString>
      <parent>cipher</parent>
      <excludedOptions>
        <options>AES-128-CBC</options>
        <options>AES-128-OFB</options>
        <options>Blowfish-CBC</options>
      </excludedOptions>
      <optional>False</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>Blowfish-CBC</name>
      <outputString>-bf-cbc</outputString>
      <parent>cipher</parent>
      <excludedOptions>
        <options>AES-128-CBC</options>
        <options>AES-128-OFB</options>
        <options>AES-256-CBC</options>
      </excludedOptions>
      <optional>False</optional>
      <locations>
      </locations>
    </configurationOption>
<!-- Message digest -->
    <configurationOption>
      <name>digest</name>
      <parent>root</parent>
      <optional>False</optional>
    </configurationOption>
    <configurationOption>
      <name>MD5</name>
      <outputString>-md=md5</outputString>
      <parent>digest</parent>
      <excludedOptions>
        <options>SHA-256</options>
      </excludedOptions>
      <optional>False</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>SHA-256</name>
      <outputString>-md=sha-256</outputString>
      <parent>digest</parent>
      <excludedOptions>
        <options>MD5</options>
      </excludedOptions>
      <optional>False</optional>
      <locations>
      </locations>
    </configurationOption>
<!-- Other Options -->
    <configurationOption>
      <name>base64</name>
      <outputString>-a</outputString>
      <parent>root</parent>
      <optional>True</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>one Line</name>
      <outputString>-A</outputString>
      <parent>base64</parent>
      <optional>True</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>PBKDF2</name>
      <outputString>-pbkdf2</outputString>
      <parent>root</parent>
      <optional>True</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>print</name>
      <outputString>-p</outputString>
      <parent>root</parent>
      <excludedOptions>
        <options>print and exit</options>
      </excludedOptions>
      <optional>True</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>print and exit</name>
      <outputString>-P</outputString>
      <parent>root</parent>
      <excludedOptions>
        <options>print</options>
      </excludedOptions>
      <optional>True</optional>
      <locations>
      </locations>
    </configurationOption>
    <configurationOption>
      <name>compress</name>
      <outputString>-z</outputString>
      <parent>root</parent>
      <optional>True</optional>
      <locations>
      </locations>
    </configurationOption>
  </binaryOptions>
  <numericOptions>
  </numericOptions>
  <booleanConstraints />
  <nonBooleanConstraints />
  <mixedConstraints />
</vm>
