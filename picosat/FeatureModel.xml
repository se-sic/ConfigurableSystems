<vm name="PicoSAT">
  <binaryOptions>
    <configurationOption>
      <name>root</name>
      <optional>False</optional>
    </configurationOption>
    <configurationOption>
      <name>Plain</name>
      <outputString>--plain</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>Solutions</name>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>AllSAT</name>
      <outputString>--all</outputString>
      <parent>Solutions</parent>
      <excludedOptions>
        <options>Partial</options>
      </excludedOptions>
      <optional>False</optional>
    </configurationOption>
    <configurationOption>
      <name>Partial</name>
      <outputString>--partial</outputString>
      <parent>Solutions</parent>
      <excludedOptions>
        <options>AllSAT</options>
      </excludedOptions>
      <optional>False</optional>
    </configurationOption>
    <configurationOption>
      <name>CompactTrace</name>
      <outputString>-t compactTraceFileName</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>ExtendedTrace</name>
      <outputString>-T extendedTraceFileName</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
    <configurationOption>
      <name>ReverseUnitPropagationProof</name>
      <outputString>-r rupFileName</outputString>
      <parent>root</parent>
      <optional>True</optional>
    </configurationOption>
  </binaryOptions>
</vm>

